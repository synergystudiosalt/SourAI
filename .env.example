# ============================================================================
# SERVER variables — read by Cloudflare Pages Functions in functions/.
#
# These stay secret because they are never exposed to the browser. They are
# removed together with functions/ once the client-only agent reaches parity
# (see docs/adr/0001-client-only-architecture.md). Until then the legacy
# /api/chat and /api/agent endpoints need them.
# ============================================================================

# Gemini API Keys (required)
# Set either a single key:
GEMINI_API_KEY=your-gemini-api-key-here

# Or multiple keys (comma-separated) for higher throughput:
# GEMINI_API_KEYS=key1,key2,key3

# Groq API Keys (optional, used as fallback)
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_API_KEYS=key1,key2,key3


# ============================================================================
# CLIENT variables — inlined into the browser bundle by Vite.
#
# ⚠ EVERY VALUE BELOW IS PUBLIC. Vite replaces `import.meta.env.VITE_*` with
#   the literal value at build time, so anyone who loads the app can read it.
#   Never put a provider API key, an OAuth client secret, a Git token, a
#   signing key, or an encryption key here. Provider credentials are supplied
#   by the user at runtime and held in memory for the session
#   (docs/adr/0005-credential-handling.md).
#
# Every variable is optional. Unset means "use the coded default".
# ============================================================================

# Deployment metadata, shown in the UI and in copied error details.
# VITE_APP_ENV=production
# VITE_RELEASE_SHA=

# Default provider and model for a fresh install.
# VITE_DEFAULT_PROVIDER=
# VITE_DEFAULT_MODEL=

# Feature flags. Accepted values: true/1/on, false/0/off. Anything else — and
# an empty string, which is what an unset Pages variable produces — falls
# through to the default in src/features/flags/registry.ts.
# VITE_ENABLE_CLIENT_AGENT=false          # Phase 3: client-only agent runtime
# VITE_ENABLE_OPFS_PROJECTS=false         # Phase 2: browser-native projects
# VITE_ENABLE_LOCAL_FOLDER_PROJECTS=true  # Phase 2: real local folders
# VITE_ENABLE_WEBCONTAINERS=false         # Phase 5: Node.js runtime
# VITE_ENABLE_PYODIDE=false               # Phase 5: Python runtime
# VITE_ENABLE_WEBLLM=false                # Phase 3: on-device models
# VITE_ENABLE_REMOTE_MCP=false            # Phase 6: Streamable HTTP MCP
# VITE_ENABLE_EDIT_PREDICTION=false       # Phase 8
# VITE_ENABLE_AUDIT_LOG=false             # Phase 9
# VITE_ENABLE_TELEMETRY=false             # Phase 9; requires explicit consent

# Allows runtime flag overrides outside development builds. Leave unset for
# production: it lets anyone with devtools switch on an unfinished code path.
# VITE_ALLOW_FLAG_OVERRIDES=false

# Origin allowlists enforced before any outbound request (comma-separated).
# VITE_ALLOWED_PROVIDER_ORIGINS=https://generativelanguage.googleapis.com
# VITE_ALLOWED_MCP_ORIGINS=

# Public OAuth client id for a browser PKCE flow. This is a public identifier,
# not a secret. A client SECRET must never appear here.
# VITE_PUBLIC_GITHUB_CLIENT_ID=

# Public Sentry DSN. Only used after telemetry consent is granted.
# VITE_SENTRY_DSN=
